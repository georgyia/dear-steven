# Copy to .env at the repository root. Never commit .env — it is gitignored.
# Every variable is optional: with none set, the app runs in demo mode with fixture answers.

# Answers, embeddings, follow-up condensation, server speech-to-text and spoken replies.
# Without it: demo mode (clearly labelled fixtures), and `pnpm ingest index` cannot embed.
OPENAI_API_KEY=your-openai-api-key

# Only for `pnpm ingest match-youtube`, which links episodes to their videos so citations can
# open YouTube at the right moment. Without it: citations show the podcast timestamp only.
YOUTUBE_API_KEY=your-youtube-api-key

# Where the knowledge base lives. Default: data/dear-steven.db (relative paths are resolved
# against the repository root). Set an absolute path in Docker, e.g. /data/dear-steven.db.
# DEAR_STEVEN_DB_PATH=

# 1 = force demo mode even when OPENAI_API_KEY is set (used by the end-to-end tests).
# DEAR_STEVEN_DEMO=

# 1 = append every answer (question, retrieved passage ids, validation results) to
# data/answers.jsonl, for the eval harness. Off by default: conversations are not stored.
# DEAR_STEVEN_LOG_ANSWERS=
