# Copy to .env at the repository root. Never commit .env — it is gitignored.
# Every variable is optional: with none set, the app runs in demo mode with fixture answers.

# Answers, embeddings, follow-up condensation, server speech-to-text and spoken replies.
# Without it: demo mode (clearly labelled fixtures), and `pnpm ingest index` cannot embed.
OPENAI_API_KEY=your-openai-api-key

# Only for `pnpm ingest match-youtube`, which links episodes to their videos so citations can
# open YouTube at the right moment. Without it: citations show the podcast timestamp only.
YOUTUBE_API_KEY=your-youtube-api-key

# Where the knowledge base lives. Default: data/dear-steven.db (relative paths are resolved
# against the repository root). Set an absolute path in Docker, e.g. /data/dear-steven.db.
# DEAR_STEVEN_DB_PATH=

# A different env file to read keys from (and, with `pnpm dev:setup`, to save them to) instead of
# this one; relative paths are resolved against the repository root. Set in the environment.
# DEAR_STEVEN_ENV_FILE=

# The podcast feed `pnpm ingest discover` reads, instead of looking it up on Apple Podcasts (a
# mirror, or the end-to-end tests' fixture feed).
# DEAR_STEVEN_FEED_URL=

# 1 = force demo mode even when OPENAI_API_KEY is set (used by the end-to-end tests).
# DEAR_STEVEN_DEMO=

# The most the web app may spend on OpenAI per UTC day, in US dollars, estimated from token use on
# every paid call. Past it, answers are an in-persona "come back tomorrow" and no OpenAI call is
# made until midnight UTC. Set it before anyone else can reach the app. Unreadable values
# (e.g. "5$") mean 0. Spend is kept in data/spend.json, next to the knowledge base.
# DEAR_STEVEN_DAILY_BUDGET_USD=2

# 0 = visitors must bring their own OpenAI key (Setup panel): OPENAI_API_KEY then serves only the
# ingest CLI and never a visitor's request. Default: on, so visitors without a key of their own
# run on OPENAI_API_KEY (as a local copy always has). A visitor's own key is never stored.
# DEAR_STEVEN_ALLOW_OPERATOR_KEY=

# Where rate limits find the client's address (P8-01). Default: the last X-Forwarded-For entry,
# the one the proxy in front of the app (or Next.js itself) wrote. With n proxies in front, set
# the count; on a platform that sets its own client-address header, name it instead (Fly.io:
# fly-client-ip). Never name a header the platform doesn't overwrite: clients could choose it.
# DEAR_STEVEN_TRUSTED_PROXIES=1
# DEAR_STEVEN_CLIENT_IP_HEADER=

# How many questions a visitor without a key of their own may ask on OPENAI_API_KEY (P8-02), before
# Steven asks them to add their own (kept in their browser). Each Ask or Talk question counts; a
# whole interview counts once. Unset: no per-visitor limit. 0: none. A public deployment: 3. Counted
# per browser and per network (three times as many), for 30 days, in data/free-questions.json.
# Needs DEAR_STEVEN_DAILY_BUDGET_USD (P8-09): someone with many addresses gets more, and only the
# cap bounds what that costs, so without a cap no free questions are given (the log says why).
# DEAR_STEVEN_FREE_QUESTIONS=3

# A passcode for a private deployment: only browsers that entered it can use the API (a signed,
# HTTP-only cookie, 30 days). Use four words or more; changing it signs everyone out.
# DEAR_STEVEN_ACCESS_CODE=

# 1 = append every answer (question, retrieved passage ids, validation results) to
# data/answers.jsonl, for the eval harness. Off by default: conversations are not stored.
# DEAR_STEVEN_LOG_ANSWERS=
