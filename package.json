{
  "name": "dear-steven",
  "private": true,
  "license": "PolyForm-Noncommercial-1.0.0",
  "type": "module",
  "packageManager": "pnpm@10.18.2",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "dev": "pnpm --filter @dear-steven/web dev",
    "dev:setup": "node scripts/dev-setup.ts",
    "build": "pnpm --filter @dear-steven/web build",
    "start": "pnpm --filter @dear-steven/web start",
    "check": "pnpm lint && pnpm typecheck && pnpm test && pnpm arch",
    "lint": "biome check .",
    "format": "biome check --write .",
    "typecheck": "pnpm -r --parallel typecheck",
    "test": "vitest run",
    "test:watch": "vitest",
    "e2e": "pnpm --filter @dear-steven/web e2e",
    "arch": "depcruise --config .dependency-cruiser.cjs packages apps/web/src eval",
    "ingest": "node packages/ingest/src/cli.ts",
    "eval": "node eval/run.ts",
    "eval:interviews": "node eval/interviews.ts",
    "policies": "node scripts/write-policies.ts"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.15",
    "@commitlint/cli": "21.2.3",
    "@commitlint/config-conventional": "21.2.3",
    "@types/node": "22.20.5",
    "dependency-cruiser": "18.5.0",
    "typescript": "6.0.3",
    "vitest": "5.0.3"
  }
}
